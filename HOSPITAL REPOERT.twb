      <column-instance column='[Calculation_0513221486829569]' derivation='Count' name='[cnt:Calculation_0513221486829569:qk]' pivot='key' type='quantitative' />
      <column-instance column='[Date of Admission]' derivation='Month' name='[mn:Date of Admission:ok]' pivot='key' type='ordinal' />
