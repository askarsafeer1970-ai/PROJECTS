      <layout dim-ordering='alphabetic' measure-ordering='alphabetic' rowDisplayCount='100' show-structure='false' />
      <style>
        <style-rule element='mark'>
          <encoding attr='color' field='[none:Admission Type:nk]' type='palette'>
