      <aliases enabled='yes' />
      <column datatype='string' name='[Admission Type]' role='dimension' type='nominal' />
      <column aggregation='Sum' datatype='integer' name='[Age]' role='dimension' type='ordinal' />
      <column aggregation='None' datatype='integer' name='[Billing Amount (bin)]' role='dimension' type='quantitative'>
        <calculation class='bin' decimals='2' formula='[Billing Amount]' peg='0' size='717' />
      </column>
      <column datatype='real' name='[Billing Amount]' role='measure' type='quantitative' />
      <column caption='avg billing amt' datatype='real' name='[Calculation_0399148912787456]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([Billing Amount])' />
      </column>
      <column caption='avg insurance discount' datatype='real' name='[Calculation_0399148912914433]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_0399148912787456]*0.1' />
      </column>
      <column caption='avg tax' datatype='real' name='[Calculation_0399148913303554]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_0399148912787456]*0.05' />
      </column>
      <column caption='avg  revenue' datatype='real' name='[Calculation_0399148913594371]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_0399148912787456]-[Calculation_0399148912914433]+[Calculation_0399148913303554]' />
      </column>
      <column caption='cost' datatype='real' name='[Calculation_0399148922822660]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Billing Amount])-[Calculation_1459902405644290]' />
      </column>
      <column aggregation='Sum' caption='DAYS' datatype='integer' name='[Calculation_0439279780544513]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;,[Date of Admission],[Discharge Date])' />
      </column>
      <column caption='early and late year' datatype='string' name='[Calculation_0439279825686531]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if datepart(&apos;month&apos;,[Date of Admission])&lt;=6&#13;&#10;THEN&#13;&#10;&quot;early year&quot;&#13;&#10;ELSE&#13;&#10;&quot;late year&quot;&#13;&#10;END' />
      </column>
      <column caption='avg cost per day' datatype='real' name='[Calculation_0439279834902532]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Billing Amount])/sum([Calculation_0439279780544513])' />
      </column>
      <column caption='insurance discount' datatype='real' name='[Calculation_0439279841447941]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Billing Amount]*0.1)' />
      </column>
      <column aggregation='CountD' caption='patients' datatype='string' default-role='measure' default-type='quantitative' name='[Calculation_0513221486829569]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='UPPER([Name])' />
      </column>
      <column caption='lower' datatype='string' name='[Calculation_0513221487624194]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='LOWER([Insurance Provider])' />
      </column>
      <column caption='LAST FOUR' datatype='string' name='[Calculation_0513221490790403]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='RIGHT([Calculation_0513221486829569],4)' />
      </column>
      <column caption='FIRST THREE' datatype='string' name='[Calculation_0513221496545284]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='LEFT([Insurance Provider],3)' />
      </column>
      <column aggregation='Sum' caption='NAMES A' datatype='integer' name='[Calculation_0513221498728453]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF STARTSWITH(UPPER([Name]),&quot;A&quot;)&#13;&#10;THEN 1 ELSE 0 END' />
      </column>
      <column caption='remove' datatype='string' name='[Calculation_0513221519163402]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='TRIM([Calculation_0513221486829569])' />
      </column>
      <column aggregation='Sum' caption=' text length' datatype='integer' name='[Calculation_0513221523402766]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='len(trim([Calculation_0513221486829569]))' />
      </column>
      <column aggregation='Sum' caption='year' datatype='integer' name='[Calculation_0523117151576064]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='year([Date of Admission])' />
      </column>
      <column caption='day of week' datatype='string' name='[Calculation_0523117154603009]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATENAME(&apos;weekday&apos;,[Date of Admission])' />
      </column>
      <column caption='discount' datatype='real' name='[Calculation_0631694557855744]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Billing Amount])-SUM([Billing Amount]*0.1)' />
      </column>
      <column aggregation='Sum' caption='days to  weeks' datatype='integer' name='[Calculation_0631694560780289]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATEDIFF(&apos;week&apos;,[Date of Admission],[Discharge Date])' />
      </column>
      <column caption='tax ' datatype='real' name='[Calculation_0631694565568514]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Billing Amount]*0.05)' />
      </column>
      <column caption='difference ' datatype='real' name='[Calculation_0631694579654661]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Billing Amount])-AVG([Billing Amount])' />
      </column>
      <column caption='age group' datatype='string' name='[Calculation_0678149814423552]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Age]&lt;20 THEN &quot;Under 20&quot;&#13;&#10;ELSEIF [Age]&lt;=40 THEN &quot;20-40&quot;&#13;&#10;ELSEIF [Age]&lt;=60 THEN &quot;41-60&quot;&#13;&#10;ELSEIF [Age]&lt;=80 THEN &quot;61-80&quot;&#13;&#10;ELSE &quot;80+&quot;&#13;&#10;END' />
      </column>
      <column caption='average days' datatype='real' name='[Calculation_0772433296064513]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([Calculation_0439279780544513])' />
      </column>
      <column caption='in vs out' datatype='string' name='[Calculation_0772433297989635]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_0439279780544513]&lt;=15.51 THEN &quot;inpatient&quot;&#13;&#10;ELSE &quot;outpatient&quot;&#13;&#10;END' />
      </column>
      <column caption='revenue' datatype='real' default-format='c&quot;₹&quot;#,##0.00;(&quot;₹&quot;#,##0.00)' name='[Calculation_1459902405644290]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Billing Amount]) - [Calculation_0439279841447941] + [Calculation_0631694565568514]' />
      </column>
      <column datatype='date' name='[Date of Admission]' role='dimension' type='ordinal' />
      <column aggregation='CountD' datatype='string' name='[Doctor]' role='dimension' type='nominal' />
      <column datatype='string' name='[Gender]' role='dimension' type='nominal' />
